<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="508.0" prefWidth="400.0" spacing="20.0" style="-fx-background-radius: 20; -fx-background-color: #eaf5ea;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bismikaa.PrimaryController">
   <children>
      <Label alignment="BASELINE_LEFT" prefHeight="43.0" prefWidth="299.0" text="Masukan Data Anda" textOverrun="CLIP">
         <font>
            <Font name="Segoe UI Black" size="29.0" />
         </font>
      </Label>
      <Label prefHeight="30.0" prefWidth="200.0" text="Berat Badan (kg) :">
         <font>
            <Font name="Segoe UI Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtBerat" prefHeight="0.0" prefWidth="382.0" promptText="Masukkan berat (kg)" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #a8e6cf; -fx-background-color: #f7faf8; -fx-padding: 8 12;">
         <VBox.margin>
            <Insets right="250.0" top="-15.0" />
         </VBox.margin>
      </TextField>
      <Label prefHeight="30.0" prefWidth="199.0" text="Tinggi Badan (cm) :">
         <font>
            <Font name="Segoe UI Bold" size="20.0" />
         </font>
      </Label>
      <TextField fx:id="txtTinggi" prefHeight="14.0" prefWidth="382.0" promptText="Masukan Tinggi" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #a8e6cf; -fx-background-color: #f7faf8; -fx-padding: 8 12;">
         <VBox.margin>
            <Insets right="250.0" top="-15.0" />
         </VBox.margin>
      </TextField>
      <HBox alignment="CENTER" prefHeight="55.0" prefWidth="360.0" spacing="15.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleHitung" prefHeight="40.0" prefWidth="400.0" style="-fx-background-color: #0f9747; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold;" text="Hitung" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
            </Button>
            <Button fx:id="handleReset" mnemonicParsing="false" onAction="#handleReset" prefHeight="40.0" prefWidth="400.0" style="-fx-background-color: #d1f2dd; -fx-background-radius: 20; -fx-text-fill: #0f9747; -fx-font-weight: bold;" text="Reset">
               <font>
                  <Font name="Yu Gothic UI Regular" size="15.0" />
               </font>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <VBox prefHeight="137.0" prefWidth="360.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #a8e6cf; -fx-padding: 0;">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="37.0" prefWidth="382.0">
               <VBox.margin>
                  <Insets left="15.0" top="10.0" />
               </VBox.margin>
               <children>
                  <Label prefHeight="21.0" prefWidth="82.0" text="Nilai BMI :">
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin>
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblNilaiBMI" prefHeight="21.0" prefWidth="82.0" text="-">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label prefHeight="21.0" prefWidth="92.0" text="Kategori  :">
               <VBox.margin>
                  <Insets bottom="15.0" left="30.0" top="5.0" />
               </VBox.margin>
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font>
            </Label>
            <Label fx:id="lblKategori" contentDisplay="CENTER" prefHeight="21.0" prefWidth="304.0" text="-">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font>
               <VBox.margin>
                  <Insets left="35.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
